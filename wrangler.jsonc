// Cloudflare Workers configuration (used only for the Cloudflare deployment; Vercel ignores it).
// Build and deploy with: npm run cf:deploy   (see docs/CLOUDFLARE.md)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard if you deploy from Git (Workers Builds).
  "name": "ieso-generation-transmission",
  // Custom entry: wraps the OpenNext worker (.open-next/worker.js) and adds the Cron Trigger handler.
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat provides the Node.js APIs Next.js and `pg` need (net sockets, crypto, Buffer, fs).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Lets the Worker call itself (used by OpenNext for caching and revalidation).
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ieso-generation-transmission"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Replaces the long-running scheduler: every hour at :15 the Worker calls its own /api/cron.
  // (Vercel's equivalent is the daily cron in vercel.json.)
  "triggers": {
    "crons": ["15 * * * *"]
  },
  // Non-secret settings. Put DATABASE_URL and CRON_SECRET in as secrets, not here.
  "vars": {
    "IESO_CACHE_DIR": "/tmp/oge-cache"
  },
  // Settings for preview versions of pull-request branches (`wrangler preview`). Secrets such as
  // DATABASE_URL are shared with production; Cron Triggers do not run on previews.
  "previews": {
    "vars": {
      "IESO_CACHE_DIR": "/tmp/oge-cache"
    }
  }
  // Recommended: put Cloudflare Hyperdrive in front of Neon (fast pooled connections). Create it with
  //   npx wrangler hyperdrive create ieso-db --connection-string="<your Neon URL>"
  // then uncomment this block (add a comma after the "vars" block above) with the id it prints:
  // ,"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive id>" }]
}
